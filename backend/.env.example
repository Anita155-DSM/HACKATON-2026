# ─── App ───────────────────────────────────────────
NODE_ENV=
PORT=
APP_NAME=# URL del frontend (se usa para armar los links de los emails)
CLIENT_URL=
# Orígenes permitidos separados por coma. "*" = todos
CORS_ORIGINS=

# ─── JWT ───────────────────────────────────────────
# Generá secretos con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=
JWT_REFRESH_EXPIRES_IN=
BCRYPT_ROUNDS=

# ─── Verificación / recuperación ──────────────────
# true = no se puede loguear hasta verificar el email
REQUIRE_EMAIL_VERIFICATION=
EMAIL_VERIFICATION_HOURS=
PASSWORD_RESET_MINUTES=
# Opcional: si no hay frontend, apuntá al backend para probar el link directo
# EMAIL_VERIFY_URL=http://localhost:3000/api/auth/verify-email
# RESET_PASSWORD_URL=http://localhost:5173/reset-password

# ─── Email (SMTP) ─────────────────────────────────
# Si SMTP_HOST está vacío, los emails se imprimen en la consola (modo dev).
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true
#        y en SMTP_PASS una "contraseña de aplicación" (no tu contraseña normal)
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# ─── Admin inicial (se crea al arrancar si no existe) ─
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=
ADMIN_LAST_NAME=

# Desactiva el rate limit (útil mientras prueban con Postman)
DISABLE_RATE_LIMIT=

# ─── PostgreSQL ───────────────────────────────────
# Opción A: URL completa (Neon, Supabase, Render, Railway...). Tiene prioridad.
# DATABASE_URL=postgres://usuario:password@host:5432/base
# DB_SSL=true
# Opción B: variables sueltas (coinciden con docker-compose.yml)
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
# alter = ajusta tablas | force = BORRA y recrea | none = no toca nada
DB_SYNC=
DB_LOGGING=
